<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hourly, because a scheduled action that is switched off is
         silent by construction: nothing fails, nothing queues, the work
         simply never happens. The last time this went unnoticed it cost
         five days, the nightly backup of the free pool's host among
         them. One indexed read per hour turns that into an alert. -->
    <record id="cron_check_disabled_crons" model="ir.cron">
        <field name="name">Alert When Our Scheduled Actions Stop</field>
        <field name="model_id" ref="base.model_ir_cron"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_disabled()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active">True</field>
    </record>
</odoo>
